# Copy to .env.local for local development. Never commit real values.
# MongoDB Atlas: use a database user limited to readWrite on the myscapez database, not an admin user.
MONGODB_URI=
MONGODB_DB=myscapez
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Bookings: jobs each morning/afternoon window can take (default 4).
BOOKING_SLOTS_PER_WINDOW=4
# Booking emails go out when RESEND_API_KEY is set. The sender must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MyScapez <bookings@myscapez.com>
# Who gets each new booking. Falls back to MYSCAPEZ_ADMIN_EMAIL, then admin@myscapez.com.
LEAD_RECIPIENT_EMAIL=
MYSCAPEZ_ADMIN_EMAIL=
